{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Snack Meet",
    "version": "1.0.0",
    "identifier": "com.meetily.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Snack Meet",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            },
            {
                "label": "recording-overlay",
                "title": "Snack Meet Recording",
                "url": "recording-overlay.html",
                "width": 340,
                "height": 92,
                "minWidth": 340,
                "minHeight": 92,
                "maxWidth": 340,
                "maxHeight": 92,
                "resizable": false,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "visibleOnAllWorkspaces": true,
                "skipTaskbar": true,
                "visible": false,
                "focus": false,
                "shadow": false
            },
            {
                "label": "recording-prompt",
                "title": "Snack Meet 录音提醒",
                "url": "recording-prompt.html",
                "width": 440,
                "height": 250,
                "minWidth": 440,
                "minHeight": 250,
                "maxWidth": 440,
                "maxHeight": 250,
                "resizable": false,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "visibleOnAllWorkspaces": true,
                "skipTaskbar": true,
                "visible": false,
                "focus": true,
                "shadow": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "media-src": "'self' asset: https://asset.localhost blob:",
                "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Snack Meet main window capability",
                    "windows": ["main"],
                    "permissions": [
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "core:window:allow-show",
                        "core:window:allow-hide",
                        "core:window:allow-set-position",
                        "core:window:allow-set-focus",
                        "core:window:allow-set-always-on-top",
                        "core:window:allow-set-visible-on-all-workspaces",
                        "core:window:allow-unminimize",
                        "core:window:allow-start-dragging",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "dialog:allow-confirm",
                        "dialog:allow-save",
                        "dialog:allow-open"
                    ]
                },
                {
                    "identifier": "recording-overlay",
                    "description": "Minimal recording overlay capability",
                    "windows": ["recording-overlay"],
                    "permissions": [
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:window:allow-show",
                        "core:window:allow-hide",
                        "core:window:allow-set-position",
                        "core:window:allow-set-focus",
                        "core:window:allow-unminimize",
                        "core:window:allow-start-dragging"
                    ]
                },
                {
                    "identifier": "recording-prompt",
                    "description": "Blocking centered meeting recording confirmation",
                    "windows": ["recording-prompt"],
                    "permissions": [
                        "core:event:default",
                        "core:window:default",
                        "core:window:allow-show",
                        "core:window:allow-hide",
                        "core:window:allow-set-position",
                        "core:window:allow-set-focus",
                        "core:window:allow-set-always-on-top",
                        "core:window:allow-set-visible-on-all-workspaces",
                        "core:window:allow-start-dragging"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        }
    }
}
